      "id": "syllogism-easy-001",
      "topic": "Syllogism",
      "subtopic": "Statement and conclusion",
      "level": "Easy",
      "question": "All A are B. All B are C. Which conclusion definitely follows?",
      "options": [
        "All A are C",
        "All B are A",
        "Some B are not C",
        "No conclusion follows"
      ],
      "answer": "All A are C",
      "solution": [
        "A is fully inside B",
        "B is fully inside C",
        "Therefore A is fully inside C"
      ]
    },
