      "subtopic": "Set diagrams",
      "level": "Medium",
      "question": "Some A are B. All B are C. Which follows?",
      "options": [
        "Some A are C",
        "All A are C",
        "No A is C",
        "Some C are B"
      ],
      "answer": "Some C are B",
      "solution": [
        "Some B exist because some A are B",
        "All B are C, so those B are C",
        "Thus some C are B"
      ]
